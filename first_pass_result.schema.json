{
  "$defs": {
    "BeamDimensionMethod": {
      "enum": [
        "direct_annotation",
        "sheet_default",
        "drawing_default",
        "beam_schedule",
        "beam_detail"
      ],
      "title": "BeamDimensionMethod",
      "type": "string"
    },
    "BeamExtent": {
      "additionalProperties": false,
      "properties": {
        "start_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Support"
        },
        "end_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Support"
        },
        "start_grid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Grid"
        },
        "end_grid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Grid"
        },
        "centreline_span": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Centreline Span"
        },
        "clear_span": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clear Span"
        },
        "overall_length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overall Length"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "start_support",
        "end_support",
        "start_grid",
        "end_grid",
        "centreline_span",
        "clear_span",
        "overall_length",
        "unit",
        "confidence"
      ],
      "title": "BeamExtent",
      "type": "object"
    },
    "ColumnDimensionMethod": {
      "enum": [
        "direct_annotation",
        "sheet_default",
        "drawing_default",
        "column_schedule",
        "column_detail"
      ],
      "title": "ColumnDimensionMethod",
      "type": "string"
    },
    "Conventions": {
      "additionalProperties": false,
      "properties": {
        "beam_dimension_methods": {
          "items": {
            "$ref": "#/$defs/BeamDimensionMethod"
          },
          "title": "Beam Dimension Methods",
          "type": "array"
        },
        "column_dimension_methods": {
          "items": {
            "$ref": "#/$defs/ColumnDimensionMethod"
          },
          "title": "Column Dimension Methods",
          "type": "array"
        }
      },
      "required": [
        "beam_dimension_methods",
        "column_dimension_methods"
      ],
      "title": "Conventions",
      "type": "object"
    },
    "DimensionComponent": {
      "additionalProperties": false,
      "description": "One side of an AxB member size.\n\nExamples:\n\n    450\n    -> raw = \"450\"\n    -> values = [450]\n\n    30/32\n    -> raw = \"30/32\"\n    -> values = [30, 32]\n\nThis lets us preserve tapered/variable dimensions rather than\nforcing them into one scalar.",
      "properties": {
        "raw": {
          "minLength": 1,
          "title": "Raw",
          "type": "string"
        },
        "values": {
          "items": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "raw",
        "values"
      ],
      "title": "DimensionComponent",
      "type": "object"
    },
    "DimensionOrder": {
      "enum": [
        "depth_x_width",
        "width_x_depth"
      ],
      "title": "DimensionOrder",
      "type": "string"
    },
    "DimensionOrderAssessment": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionOrder"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "order",
        "confidence"
      ],
      "title": "DimensionOrderAssessment",
      "type": "object"
    },
    "DimensionUnit": {
      "enum": [
        "mm",
        "in"
      ],
      "title": "DimensionUnit",
      "type": "string"
    },
    "DrawingDimensionOrder": {
      "additionalProperties": false,
      "properties": {
        "beam": {
          "$ref": "#/$defs/DimensionOrderAssessment"
        },
        "column": {
          "$ref": "#/$defs/DimensionOrderAssessment"
        }
      },
      "required": [
        "beam",
        "column"
      ],
      "title": "DrawingDimensionOrder",
      "type": "object"
    },
    "DrawingSet": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "items": {
            "$ref": "#/$defs/DimensionUnit"
          },
          "minItems": 1,
          "title": "Units",
          "type": "array"
        },
        "dimension_order": {
          "$ref": "#/$defs/DrawingDimensionOrder"
        }
      },
      "required": [
        "units",
        "dimension_order"
      ],
      "title": "DrawingSet",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "description": "One dimension-resolved member occurrence / level scope.\n\n`key` is unique within the JSON output.\n\n`drawing_id` is the actual designation printed on the drawing, if one\nexists. The same drawing_id may legitimately occur at several levels.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "drawing_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drawing Id"
        },
        "type": {
          "$ref": "#/$defs/ElementType"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level"
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementSize"
            },
            {
              "type": "null"
            }
          ]
        },
        "vertical_extent": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerticalExtent"
            },
            {
              "type": "null"
            }
          ]
        },
        "beam_extent": {
          "anyOf": [
            {
              "$ref": "#/$defs/BeamExtent"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "location": {
          "$ref": "#/$defs/ElementLocation"
        },
        "needs_verification": {
          "title": "Needs Verification",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "drawing_id",
        "type",
        "level",
        "size",
        "vertical_extent",
        "beam_extent",
        "resolution",
        "location",
        "needs_verification"
      ],
      "title": "Element",
      "type": "object"
    },
    "ElementDefault": {
      "additionalProperties": false,
      "properties": {
        "element_type": {
          "$ref": "#/$defs/ElementType"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/ElementSize"
        },
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/NormalizedBBox"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "element_type",
        "scope",
        "size",
        "page",
        "bbox",
        "confidence"
      ],
      "title": "ElementDefault",
      "type": "object"
    },
    "ElementLocation": {
      "additionalProperties": false,
      "description": "Location of the actual structural member on the plan.\n\nbbox is nullable because the model may identify a member semantically\nwithout being confident enough to provide its physical region.",
      "properties": {
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedBBox"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "ElementLocation",
      "type": "object"
    },
    "ElementSize": {
      "additionalProperties": false,
      "description": "Preserve drawing notation separately from normalized interpretation.\n\nExample:\n    raw = '30\"/32\" x 18\"'\n    first.raw = '30/32'\n    first.values = [30, 32]\n    second.values = [18]\n\nwidth/depth can remain null if the ordering convention is uncertain.",
      "properties": {
        "raw": {
          "minLength": 1,
          "title": "Raw",
          "type": "string"
        },
        "first": {
          "$ref": "#/$defs/DimensionComponent"
        },
        "second": {
          "$ref": "#/$defs/DimensionComponent"
        },
        "unit": {
          "$ref": "#/$defs/DimensionUnit"
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionComponent"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionComponent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "raw",
        "first",
        "second",
        "unit",
        "width",
        "depth"
      ],
      "title": "ElementSize",
      "type": "object"
    },
    "ElementType": {
      "enum": [
        "beam",
        "column"
      ],
      "title": "ElementType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where the evidence for the dimension came from.\n\nThis is intentionally separate from ElementLocation.\n\nExample:\n    element is on page 9\n    dimension is resolved from a schedule on page 12",
      "properties": {
        "source_type": {
          "$ref": "#/$defs/ResolutionSource"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedBBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Text"
        }
      },
      "required": [
        "source_type",
        "page",
        "bbox",
        "raw_text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NormalizedBBox": {
      "additionalProperties": false,
      "description": "Normalized page coordinates.\n\nOrigin: top-left\nx increases left -> right\ny increases top -> bottom",
      "properties": {
        "left": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Left",
          "type": "number"
        },
        "top": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Top",
          "type": "number"
        },
        "right": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Right",
          "type": "number"
        },
        "bottom": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Bottom",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "NormalizedBBox",
      "type": "object"
    },
    "Readability": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Readability",
      "type": "string"
    },
    "ReferenceSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ReferenceSourceType"
        },
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/NormalizedBBox"
        },
        "readability": {
          "$ref": "#/$defs/Readability"
        },
        "needs_high_resolution": {
          "title": "Needs High Resolution",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "page",
        "bbox",
        "readability",
        "needs_high_resolution"
      ],
      "title": "ReferenceSource",
      "type": "object"
    },
    "ReferenceSourceType": {
      "enum": [
        "column_schedule",
        "beam_schedule",
        "column_details",
        "beam_details",
        "general_notes",
        "default_size_note"
      ],
      "title": "ReferenceSourceType",
      "type": "string"
    },
    "Resolution": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "$ref": "#/$defs/ResolutionSource"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "source_type",
        "confidence",
        "evidence"
      ],
      "title": "Resolution",
      "type": "object"
    },
    "ResolutionSource": {
      "enum": [
        "direct_annotation",
        "sheet_default",
        "drawing_default",
        "beam_schedule",
        "column_schedule",
        "beam_detail",
        "column_detail",
        "inferred",
        "unresolved"
      ],
      "title": "ResolutionSource",
      "type": "string"
    },
    "VerificationPurpose": {
      "enum": [
        "read_direct_annotation",
        "read_column_schedule",
        "read_beam_schedule",
        "read_column_detail",
        "read_beam_detail",
        "resolve_member_association",
        "determine_dimension_order",
        "resolve_conflicting_evidence"
      ],
      "title": "VerificationPurpose",
      "type": "string"
    },
    "VerificationRequest": {
      "additionalProperties": false,
      "description": "A targeted region worth sending through a higher-resolution second pass.",
      "properties": {
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/NormalizedBBox"
        },
        "purpose": {
          "$ref": "#/$defs/VerificationPurpose"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_for": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required For",
          "type": "array"
        }
      },
      "required": [
        "page",
        "bbox",
        "purpose",
        "reason",
        "required_for"
      ],
      "title": "VerificationRequest",
      "type": "object"
    },
    "VerticalExtent": {
      "additionalProperties": false,
      "properties": {
        "bottom_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bottom Level"
        },
        "top_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top Level"
        },
        "bottom_elevation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bottom Elevation"
        },
        "top_elevation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top Elevation"
        },
        "floor_to_floor_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor To Floor Height"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "bottom_level",
        "top_level",
        "bottom_elevation",
        "top_elevation",
        "floor_to_floor_height",
        "unit",
        "confidence"
      ],
      "title": "VerticalExtent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "drawing_set": {
      "$ref": "#/$defs/DrawingSet"
    },
    "conventions": {
      "$ref": "#/$defs/Conventions"
    },
    "defaults": {
      "items": {
        "$ref": "#/$defs/ElementDefault"
      },
      "title": "Defaults",
      "type": "array"
    },
    "reference_sources": {
      "items": {
        "$ref": "#/$defs/ReferenceSource"
      },
      "title": "Reference Sources",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "title": "Elements",
      "type": "array"
    },
    "verification_requests": {
      "items": {
        "$ref": "#/$defs/VerificationRequest"
      },
      "title": "Verification Requests",
      "type": "array"
    }
  },
  "required": [
    "drawing_set",
    "conventions",
    "defaults",
    "reference_sources",
    "elements",
    "verification_requests"
  ],
  "title": "DrawingExtraction",
  "type": "object"
}
